{
  "manifestVersion": 1,
  "id": "stacked-pull-requests",
  "name": " Pull Requests (Stacked)",
  "version": "0.2.0",
  "publisher": "Pro-Sharp",
  "public": true,
  "description": "Review stacked pull requests layer by layer: a hierarchy of dependent PRs across all repositories, with a branch-only diff, and full review features.",
  "categories": ["Azure Repos"],
  "tags": ["pull request", "stacked", "review", "code review"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services.Cloud" },
    { "id": "Microsoft.TeamFoundation.Server", "version": "[19.0,)" }
  ],
  "demands": ["api-version/7.0"],
  "icons": { "default": "static/icon.png" },
  "scopes": [
    "vso.code_write",
    "vso.code_status",
    "vso.build",
    "vso.work",
    "vso.identity",
    "vso.graph",
    "vso.extension.data_write"
  ],
  "content": { "details": { "path": "README.md" } },
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "static", "addressable": true },
    { "path": "docs/images", "addressable": true }
  ],
  "contributions": [
    {
      "id": "stacked-prs-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-code-web.code-hub-group"],
      "properties": {
        "name": " Pull Requests (Stacked)",
        "order": 101,
        "uri": "dist/hub.html",
        "iconName": "BranchPullRequest"
      }
    },
    {
      "id": "stacked-prs-pr-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Stack",
        "uri": "dist/pr-tab.html"
      }
    },
    {
      "id": "stacked-prs-pr-action",
      "type": "ms.vss-web.action",
      "targets": ["ms.vss-code-web.pull-request-action-menu"],
      "properties": {
        "text": "Open stacked review",
        "title": "Review this pull request in the stack-aware view",
        "icon": "static/icon.png",
        "registeredObjectId": "stacked-prs-pr-action-handler",
        "uri": "dist/pr-action.html"
      }
    }
  ]
}
